memory heap: u32;

import "host" as host {
    func draw_rect(x: i32, y: i32, w: i32, h: i32, color: u32);
    func clear(color: u32);
    func poll_key() -> i32;
    func get_time_ms() -> i64;
}

// ── allocator ─────────────────────────────────────────────────────────────────
// The address of the next free byte. Nothing is ever freed: `reset` rewinds it.
// It starts one word past 0, so no allocation is ever `RawPtr::null()`.
global mut bump: u32 = 4;

func alloc<T: StackValue>() -> heap::*T {
    local ptr =
        RawPtr::<heap, T>::from_addr(bump.get()).align_up(
            align_of::<T, heap>(),
        );
    local new_end = ptr.addr() + size_of::<T, heap>();
    local cur_end = heap.size_bytes();
    if new_end > cur_end {
        _
            = heap.grow(
                (new_end - cur_end + heap::PAGE_SIZE - 1) / heap::PAGE_SIZE,
            );
    }
    bump.set(new_end);
    ptr.as_ptr()
}

// ── game state ────────────────────────────────────────────────────────────────
enum Direction(u32) {
    Right = 0,
    Down = 1,
    Left = 2,
    Up = 3,
}

const CELL_SIZE: i32 = 8;
const GRID_W: i32 = 32;
const GRID_H: i32 = 24;
const STEP_MS: i64 = 120;

/// One body segment; `next` is the segment behind it, null at the tail.
struct Node(x: i32, y: i32, next: RawPtr<heap, Node>);

// The address of the head segment, 0 when the snake is empty.
global mut head: u32 = 0;
global mut dir: Direction = Direction::Right;
global mut food_x: i32 = 16;
global mut food_y: i32 = 12;
global mut acc_ms: i64 = 0;

func push_front(x: i32, y: i32) {
    local n = alloc::<Node>();
    n.* = Node({ x, y, next: RawPtr::from_addr(head.get()) });
    head.set(RawPtr::from_ptr(n).addr());
}

func pop_back() {
    local first = RawPtr::<heap, Node>::from_addr(head.get());
    if first.is_null() { return };
    if first.as_ref().next.is_null() {
        head.set(0);
        return;
    }
    local mut cur = first;
    loop {
        local next = cur.as_ref().next;
        if next.as_ref().next.is_null() {
            cur.as_ptr().next = RawPtr::null();
            break;
        }
        cur = next;
    }
}

func contains(x: i32, y: i32) -> Bool {
    local mut cur = RawPtr::<heap, Node>::from_addr(head.get());
    loop {
        if cur.is_null() { break False };
        local n = cur.as_ref();
        if n.x == x && n.y == y { break True };
        cur = n.next;
    }
}

func place_food() {
    local t = i32_wrap_i64(host::get_time_ms());
    local mut fx = (t % GRID_W + GRID_W) % GRID_W;
    local fy = ((t / 13) % GRID_H + GRID_H) % GRID_H;
    if contains(fx, fy) {
        fx = (fx + 3) % GRID_W;
    }
    food_x.set(fx);
    food_y.set(fy);
}

func reset() {
    bump.set(4);
    head.set(0);
    acc_ms.set(0);
}

func start() {
    reset();

    // Tail first, so the head is the rightmost segment, facing `Right`.
    push_front(3, 5);
    push_front(4, 5);
    push_front(5, 5);
    dir.set(Direction::Right);
    place_food();
}

/// The direction the key turns to, unless it would reverse onto the body.
func turn(key: i32, current: Direction) -> Direction {
    match (key, current) {
        (1, Direction::Right) | (2, Direction::Up) | (3, Direction::Left) | (4, Direction::Down) => current,
        (1, _) => Direction::Left,
        (2, _) => Direction::Down,
        (3, _) => Direction::Right,
        (4, _) => Direction::Up,
        _ => current,
    }
}

func step() {
    dir.set(turn(host::poll_key(), dir.get()));

    local first = RawPtr::<heap, Node>::from_addr(head.get());
    local (mut hx, mut hy) = if first.is_null() {
        (0, 0)
    } else {
        local n = first.as_ref();
        (n.x, n.y)
    };
    match dir.get() {
        Direction::Right => hx = (hx + 1) % GRID_W,
        Direction::Down => hy = (hy + 1) % GRID_H,
        Direction::Left => hx = (hx - 1 + GRID_W) % GRID_W,
        Direction::Up => hy = (hy - 1 + GRID_H) % GRID_H,
    }

    if contains(hx, hy) {
        start();
        return;
    }

    push_front(hx, hy);

    if hx == food_x.get() && hy == food_y.get() {
        place_food()
    } else {
        pop_back()
    }
}

func update(dt: i64) {
    acc_ms.set(acc_ms.get() + dt);
    loop {
        if acc_ms.get() < STEP_MS { break };
        acc_ms.set(acc_ms.get() - STEP_MS);
        step();
    }
}

func draw() {
    host::clear(0xFF101010);

    host::draw_rect(
        food_x.get() * CELL_SIZE,
        food_y.get() * CELL_SIZE,
        CELL_SIZE,
        CELL_SIZE,
        0xFFFFFF00,
    );

    local mut cur = RawPtr::<heap, Node>::from_addr(head.get());
    local mut color: u32 = 0xFFFF0000; // the head, then the body
    loop {
        if cur.is_null() { break };
        local n = cur.as_ref();
        host::draw_rect(
            n.x * CELL_SIZE,
            n.y * CELL_SIZE,
            CELL_SIZE,
            CELL_SIZE,
            color,
        );
        color = 0xFF00FF00;
        cur = n.next;
    }
}

export {
    heap as "memory",
    start,
    update,
    draw,
}
