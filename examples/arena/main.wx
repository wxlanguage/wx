use std::*;

struct Arena<Mem: Memory> {
    start: Mem::&u8,
    end: Mem::&u8,
    cursor: Mem::&u8,
}

impl<Mem: Memory> Arena<Mem> {
    fn new(buffer: Mem::&[u8]) -> Self {
        Self::{
            start: buffer.ptr(),
            end: ptr::add(buffer.ptr(), buffer.len()),
            cursor: buffer.ptr(),
        }
    }
}

impl f32 {
    const PI: f32 = 3.14;
}

fn test() {
    local x = f32::PI;
}
