// Numbers as text. Nothing here writes anywhere: each function fills the end
// of a buffer the caller gives it and returns a view of the digits, so it
// works in any memory and with any output (a file descriptor, a buffer, a
// test). Print with `fd.write(arena, fmt::decimal(buffer, 42))`.
package "slices" as slices;

/// The room `decimal` needs for any `u32`.
pub const DECIMAL_LEN: u32 = 10;
/// The room `signed` needs for any `i32`.
pub const SIGNED_LEN: u32 = 11;
/// The room `hex` needs for any `u32`.
pub const HEX_LEN: u32 = 8;

/// `value` in decimal, written at the end of `buffer`, which must hold
/// `DECIMAL_LEN` bytes.
pub func decimal<M: Memory>(buffer: M::*[u8], mut value: u32) -> M::&[u8] {
    local mut at = buffer.len();
    loop {
        at -= 1;
        buffer[at] = transmute('0' + value % 10);
        value /= 10;
        if value == 0 { break };
    }
    slices::slice_at(buffer, at, buffer.len() - at)
}

/// `value` in decimal with a minus sign when negative, written at the end of
/// `buffer`, which must hold `SIGNED_LEN` bytes.
pub func signed<M: Memory>(buffer: M::*[u8], value: i32) -> M::&[u8] {
    if value >= 0 { return decimal::<M>(buffer, transmute(value)) };
    // The magnitude as a `u32`, which also holds that of the smallest `i32`.
    local digits = decimal::<M>(buffer, 0 - transmute::<i32, u32>(value));
    local at = buffer.len() - digits.len() - 1;
    buffer[at] = '-';
    slices::slice_at(buffer, at, digits.len() + 1)
}

/// `value` in lowercase hexadecimal without leading zeros, written at the end
/// of `buffer`, which must hold `HEX_LEN` bytes.
pub func hex<M: Memory>(buffer: M::*[u8], mut value: u32) -> M::&[u8] {
    local mut at = buffer.len();
    loop {
        at -= 1;
        local digit = value % 16;
        buffer[at]
            = transmute(if digit < 10 {
                '0' + digit
            } else {
                'a' + digit - 10
            });
        value /= 16;
        if value == 0 { break };
    }
    slices::slice_at(buffer, at, buffer.len() - at)
}
