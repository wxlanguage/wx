use std::*;

// Bump allocator — the simplest possible dynamic memory allocator.
//
// Strategy: maintain a `bump` pointer that starts right after static data
// (heap::DATA_END) and advances with every allocation.  There is no free —
// only reset.  Pages are grown on demand.
//
// Allocation layout (example — no free, sequential):
//
//   ┌──────────────┬──────────┬──────────┬──────────┬────── ·· ─┐
//   │  static data │  alloc 0 │  alloc 1 │  alloc 2 │  (free)   │
//   └──────────────┴──────────┴──────────┴──────────┴────── ·· ─┘
//   0          DATA_END                            bump      heap end
#[memory_limits(min_pages = 1)]
memory heap: Memory where { Size = u32 };
// start with one 64 KiB page
// ── allocator state ───────────────────────────────────────────────────────────
// Starts at 4, not `heap::DATA_END` — this example never emits static data,
// so `DATA_END` is 0, and address 0 is bit-identical to `ptr::null()`. A
// real allocation landing there would get misread as null by any
// `== ptr::null()` check, so `bump` starts one word past it instead.
global mut bump: heap::*u8 = 4 as heap::*u8;

// ── core allocator ────────────────────────────────────────────────────────────
// Allocates space for one T, respecting its alignment.
pub fn alloc<T>() -> heap::*T {
    local align = align_of::<T, heap>();
    local ptr = ptr::align_up::<heap>(bump as u32, align);
    local new_end = ptr + size_of::<T, heap>();
    local cur_end = heap.size_bytes();
    if new_end > cur_end {
        local needed = (new_end - cur_end + heap::PAGE_SIZE - 1) / heap::PAGE_SIZE;
        local _grew = heap.grow(needed);
    }
    bump = new_end as heap::*u8;
    ptr as heap::*T
}

pub fn reset() {
    bump = 4 as heap::*u8
}

pub fn bytes_used() -> u32 {
    bump as u32
}

struct Node {
    value: i32,
    next: &Node,
}

impl Node {
    pub fn new(value: i32, next: &Node) -> &Node {
        local n = alloc::<Node>();
        n.* = Node::{ value: value, next: next };
        n
    }
}

// ── demo entry point ──────────────────────────────────────────────────────────
// Builds the list  3 → 2 → 1  and returns the sum of all node values.
pub fn demo() -> i32 {
    local n1 = Node::new(1, ptr::null());
    local n2 = Node::new(2, n1);
    local n3 = Node::new(3, n2);
    
    local mut sum: i32 = 0;
    local mut cur: &Node = n3;
    loop {
        if cur == ptr::null() { break sum };
        sum += cur.*.value;
        cur = cur.*.next;
    }
}

export {
    heap as "memory",
    reset,
    bytes_used,
    demo,
}
