// Bump allocator — the simplest possible dynamic memory allocator.
//
// Strategy: maintain a `bump` pointer that starts right after static data
// (heap::DATA_END) and advances with every allocation.  There is no free —
// only reset.  Pages are grown on demand.
//
// Allocation layout (example — no free, sequential):
//
//   ┌──────────────┬──────────┬──────────┬──────────┬────── ·· ─┐
//   │  static data │  alloc 0 │  alloc 1 │  alloc 2 │  (free)   │
//   └──────────────┴──────────┴──────────┴──────────┴────── ·· ─┘
//   0          DATA_END                            bump      heap end
#[memory_limits({ min_pages: 1 })]
memory heap: u32; // start with one 64 KiB page

// ── allocator state ───────────────────────────────────────────────────────────
// The address of the next free byte. It starts at 4, not `heap::DATA_END`:
// this example never emits static data, so `DATA_END` is 0, and address 0 is
// `RawPtr::null()`. A real allocation landing there would be misread as null,
// so `bump` starts one word past it instead.
global mut bump: u32 = 4;

// ── core allocator ────────────────────────────────────────────────────────────
// Allocates space for one T, respecting its alignment.
pub func alloc<T: StackValue>() -> heap::*T {
    local ptr =
        RawPtr::<heap, T>::from_addr(bump.get()).align_up(
            align_of::<T, heap>(),
        );
    local new_end = ptr.addr() + size_of::<T, heap>();
    local cur_end = heap.size_bytes();
    if new_end > cur_end {
        local needed =
            (new_end - cur_end + heap::PAGE_SIZE - 1) / heap::PAGE_SIZE;
        _ = heap.grow(needed);
    }
    bump.set(new_end);
    ptr.as_ptr()
}

pub func reset() {
    bump.set(4)
}

pub func bytes_used() -> u32 {
    bump.get()
}

struct Node(value: i32, next: RawPtr<heap, Node>);

impl Node {
    pub func new(value: i32, next: RawPtr<heap, Node>) -> RawPtr<heap, Node> {
        local n = alloc::<Node>();
        n.* = Node({ value, next });
        RawPtr::from_ptr(n)
    }
}

// ── demo entry point ──────────────────────────────────────────────────────────
// Builds the list  3 → 2 → 1  and returns the sum of all node values.
pub func demo() -> i32 {
    local n1 = Node::new(1, RawPtr::null());
    local n2 = Node::new(2, n1);
    local n3 = Node::new(3, n2);

    local mut sum: i32 = 0;
    local mut cur = n3;
    loop {
        if cur.is_null() { break sum };
        local node = cur.as_ref();
        sum += node.value;
        cur = node.next;
    }
}

export {
    heap as "memory",
    reset,
    bytes_used,
    demo,
}
