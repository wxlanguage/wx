// Sub-slices, until a slice range (`bytes[start..end]`) is checked by the
// compiler. This is the one place that builds a slice from parts.

/// The `length` elements of `bytes` from `start`. Traps if they are not all
/// inside `bytes`.
pub func slice_at<M: Memory>(
    bytes: M::&[u8],
    start: M::Size,
    length: M::Size,
) -> M::&[u8] {
    if start > bytes.len() || length > bytes.len() - start { trap() };
    // The address of element `start` does not exist at the very end.
    if length == 0 { return "" };
    slice_from_parts(bytes[start].&, length)
}
