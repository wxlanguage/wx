// args: prints each command-line argument on its own line, numbered from 0.
// With no argument besides the program's name it prints a usage message to
// standard error and fails.
package "wasi" as wasi;
package "fmt" as fmt;
use wasi::{Fd, heap};

func main() {
    local arena = wasi::arena();
    local digits = arena.allocate_slice_uninit::<u8>(fmt::DECIMAL_LEN);
    local arguments = wasi::args(arena);
    if arguments.len() < 2 { wasi::panic(arena, "usage: args <word>...") };
    local mut i: u32 = 0;
    loop {
        if i == arguments.len() { break };
        Fd::Stdout.write(arena, fmt::decimal::<heap>(digits, i));
        Fd::Stdout.write(arena, ": ");
        Fd::Stdout.write(arena, arguments[i]);
        Fd::Stdout.write(arena, "\n");
        i += 1;
    }
}

export {
    main as "_start",
    heap as "memory",
}
