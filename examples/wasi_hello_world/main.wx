// WASI Preview 1 "hello world" — imports `fd_write` directly from the
// `wasi_snapshot_preview1` module (the raw core-wasm ABI WASI hosts expose),
// builds a WASI iovec in linear memory, and writes it to fd 1 (stdout).

crate "alloc" as alloc;

enum FileDescriptor(u8) {
    StdIn = 0,
    StdOut,
    StdErr,
}

import "wasi_snapshot_preview1" as wasi {
    use super::{heap, FileDescriptor};
    func fd_write(
        file_descriptor: FileDescriptor,
        io_vecs: heap::&[heap::&[u8]],
        bytes_written: heap::*u32,
    ) -> i32;
}

#[memory_limits({ min_pages: 1 })]
memory heap: u32;

/// The shared bump allocator for `heap`. `bootstrap` places it right after
/// static data on first use and returns the same allocator afterwards.
func allocator() -> heap::*alloc::BumpAllocator<heap> {
    alloc::BumpAllocator::<heap>::bootstrap(heap)
}

func main() {
    local alloc = allocator();
    local io_vecs = alloc.allocate_slice_uninit::<heap::&[u8]>(1);
    io_vecs[0] = "Hello, world!\n";
    local written = alloc.allocate_value::<u32>(0);
    _ = wasi::fd_write(FileDescriptor::StdOut, io_vecs.*.&, written);
}

export {
    main as "_start",
    heap as "memory",
}
