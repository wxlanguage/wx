// Reduces `x` to `x - n*(pi/2)`, returning `(n, y0, y1)` where `y0 + y1` is the remainder in
// double-double form — `y0` carries the value, `y1` the tail that `y0` couldn't represent. Used
// by `sin`/`cos` to bring their argument into `[-pi/4, pi/4]` before applying a polynomial
// approximation. Ported from Rust's `compiler-builtins` `libm/src/math/rem_pio2.rs`, itself a
// port of FreeBSD's `e_rem_pio2.c` (Sun Microsystems' fdlibm, optimised by Bruce D. Evans).
//
// The caller must handle `|x| ~<= pi/4` itself — no reduction is needed there, and this doesn't
// check for it.
//
// The first few multiples of pi/2 get a dedicated branch each: subtracting a known `k*pi/2` in
// two pieces (`PIO2_1` + `PIO2_1T`) is both cheaper and more accurate than the general path,
// except right at `|x| ~= k*pi/2` where that subtraction cancels catastrophically — those exact
// high-word values are routed to `medium` instead.
//
// The original also handles arbitrarily large `x` via `rem_pio2_large` (Payne-Hanek reduction
// against a hardcoded table of 2/pi's bits) — not ported here, the same decision already made
// for `rem_pio2f.wx`: it's a large, separate algorithm, and no current caller needs arguments
// that big. Past `|x| < 2^20 * (pi/2)` (~1.65e6) this returns `(0, NaN, NaN)` instead. For
// `inf`/`NaN` that's exactly what the original produces anyway (it returns `(0, x-x, x-x)`), so
// the two only differ on large *finite* arguments.

const TO_INT: f64 = 1.5 / f64::EPSILON;

// 53 bits of 2/pi — 0x3FE45F30, 0x6DC9C883
const INV_PIO2: f64 = 6.36619772367581382433e-01;
// first 33 bits of pi/2 — 0x3FF921FB, 0x54400000
const PIO2_1: f64 = 1.57079632673412561417e+00;
// pi/2 - PIO2_1 — 0x3DD0B461, 0x1A626331
const PIO2_1T: f64 = 6.07710050650619224932e-11;
// second 33 bits of pi/2 — 0x3DD0B461, 0x1A600000
const PIO2_2: f64 = 6.07710050630396597660e-11;
// pi/2 - (PIO2_1 + PIO2_2) — 0x3BA3198A, 0x2E037073
const PIO2_2T: f64 = 2.02226624879595063154e-21;
// third 33 bits of pi/2 — 0x3BA3198A, 0x2E000000
const PIO2_3: f64 = 2.02226624871116645580e-21;
// pi/2 - (PIO2_1 + PIO2_2 + PIO2_3) — 0x397B839A, 0x252049C1
const PIO2_3T: f64 = 8.47842766036889956997e-32;

// The general reduction for `|x| < 2^20*(pi/2)`: compute `n = rint(x/(pi/2))` and subtract
// `n*(pi/2)` in as many pieces of pi/2 as the cancellation demands. One round is good to 85
// bits, two to 118, three to 151 — enough for every argument in range.
fn medium(x: f64, ix: u64) -> (i32, f64, f64) {
    // Specialised rint(): adding then subtracting 1.5/EPSILON forces rounding to an integer
    // without a round-trip through an integer type. Assumes round-to-nearest, which is the
    // only mode wasm has.
    local tmp = x * INV_PIO2 + TO_INT;
    local f_n = tmp - TO_INT;
    local n = f_n.to_i32();

    // 1st round, good to 85 bits.
    local mut r = x - f_n * PIO2_1;
    local mut w = f_n * PIO2_1T;
    local mut y0 = r - w;

    // Compare `x`'s exponent against the remainder's: a large drop means the subtraction
    // cancelled away most of the significand, and the next piece of pi/2 is needed.
    local ex = (ix >> 20) as i64;
    local ey = ((y0.to_bits() >> 52) & 0x7ff) as i64;

    if ex - ey > 16 {
        // 2nd round, good to 118 bits.
        local t = r;
        w = f_n * PIO2_2;
        r = t - w;
        w = f_n * PIO2_2T - ((t - r) - w);
        y0 = r - w;

        local ey = ((y0.to_bits() >> 52) & 0x7ff) as i64;
        if ex - ey > 49 {
            // 3rd round, good to 151 bits — covers all cases.
            local t = r;
            w = f_n * PIO2_3;
            r = t - w;
            w = f_n * PIO2_3T - ((t - r) - w);
            y0 = r - w;
        }
    };

    (n, y0, (r - y0) - w)
}

pub fn rem_pio2(x: f64) -> (i32, f64, f64) {
    // The top 32 bits of `x`: sign, exponent, and the high 20 bits of the significand. Kept as
    // a `u64` rather than narrowed to `u32` — every test below is against a literal, so the
    // extra width costs nothing and saves a `i32_wrap_i64` at each use.
    local hx = x.to_bits() >> 32;
    local sign = (hx >> 31) != 0;
    local ix = hx & 0x7fffffff;

    if ix <= 0x400f6a7a {
        // |x| ~<= 5pi/4
        if (ix & 0xfffff) == 0x921fb {
            // |x| ~= pi/2 or 2*pi/2 — cancellation, use the medium case
            return medium(x, ix);
        };
        if ix <= 0x4002d97c {
            // |x| ~<= 3pi/4 — one round, good to 85 bits
            if sign {
                local z = x + PIO2_1;
                local y0 = z + PIO2_1T;
                return (-1, y0, (z - y0) + PIO2_1T);
            };
            local z = x - PIO2_1;
            local y0 = z - PIO2_1T;
            return (1, y0, (z - y0) - PIO2_1T);
        };
        if sign {
            local z = x + 2.0 * PIO2_1;
            local y0 = z + 2.0 * PIO2_1T;
            return (-2, y0, (z - y0) + 2.0 * PIO2_1T);
        };
        local z = x - 2.0 * PIO2_1;
        local y0 = z - 2.0 * PIO2_1T;
        return (2, y0, (z - y0) - 2.0 * PIO2_1T);
    };

    if ix <= 0x401c463b {
        // |x| ~<= 9pi/4
        if ix <= 0x4015fdbc {
            // |x| ~<= 7pi/4
            if ix == 0x4012d97c {
                // |x| ~= 3pi/2
                return medium(x, ix);
            };
            if sign {
                local z = x + 3.0 * PIO2_1;
                local y0 = z + 3.0 * PIO2_1T;
                return (-3, y0, (z - y0) + 3.0 * PIO2_1T);
            };
            local z = x - 3.0 * PIO2_1;
            local y0 = z - 3.0 * PIO2_1T;
            return (3, y0, (z - y0) - 3.0 * PIO2_1T);
        };
        if ix == 0x401921fb {
            // |x| ~= 4pi/2
            return medium(x, ix);
        };
        if sign {
            local z = x + 4.0 * PIO2_1;
            local y0 = z + 4.0 * PIO2_1T;
            return (-4, y0, (z - y0) + 4.0 * PIO2_1T);
        };
        local z = x - 4.0 * PIO2_1;
        local y0 = z - 4.0 * PIO2_1T;
        return (4, y0, (z - y0) - 4.0 * PIO2_1T);
    };

    // |x| ~< 2^20*(pi/2), medium size — 33+33+33 bit pi is good enough here.
    if ix < 0x413921fb { return medium(x, ix); };

    // Large finite `x`, or `x` is inf/NaN — the former would need `rem_pio2_large`, the latter
    // is a genuine NaN result either way (`x - x` for inf or NaN is NaN in the original); both
    // collapse to the same answer here.
    (0, f64::NAN, f64::NAN)
}
