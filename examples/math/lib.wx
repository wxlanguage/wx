mod k_cosf;
mod k_sinf;
mod scalbn;
mod rem_pio2f;
pub mod sinf;
pub mod cosf;
mod k_cos;
mod k_sin;
mod rem_pio2;
pub mod sin;
pub mod cos;

pub trait Float: StackValue {
    func cos(self: Self) -> Self;

    func sin(self: Self) -> Self;

    const PI: Self;

    const FRAC_PI_2: Self;
}

impl Float for f32 {
    func sin(self: Self) -> Self {
        sinf::sinf(self)
    }

    func cos(self: Self) -> Self {
        cosf::cosf(self)
    }

    /// Archimedes' constant (π)
    const PI: f32 = 3.14159265358979323846264338327950288;

    /// π/2
    const FRAC_PI_2: Self = 1.0;
}

impl Float for f64 {
    func sin(self: Self) -> Self {
        sin::sin(self)
    }

    func cos(self: Self) -> Self {
        cos::cos(self)
    }

    /// Archimedes' constant (π)
    const PI: f64 = 3.14159265358979323846264338327950288;

    /// π/2
    const FRAC_PI_2: f64 = 1.57079632679489661923132169163975144;
}
