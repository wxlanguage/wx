use std::*;

impl f64 {
  /// Archimedes' constant (π)
  pub const PI: f64 = 3.14159265358979323846264338327950288;

  /// π/2
  pub const FRAC_PI_2: f64 = 1.57079632679489661923132169163975144;
}

impl f32 {
  /// Archimedes' constant (π)
  pub const PI: f32 = 3.14159265358979323846264338327950288;

  /// π/2
  pub const FRAC_PI_2: f32 = 1.57079632679489661923132169163975144;
}

mod k_cosf;
mod k_sinf;
mod scalbn;
mod rem_pio2f;
mod sinf;
mod cosf;

pub use sinf::sinf;
pub use cosf::cosf;

trait Float {
  fn cos(self) -> Self;

  fn sin(self) -> Self;
}

impl Float for f32 {
  fn sin(self) -> Self {
    sinf(self)
  }

  fn cos(self) -> Self {
    cosf(self)
  }
}
