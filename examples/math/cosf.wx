use crate::{k_cosf::k_cosf, k_sinf::k_sinf, rem_pio2f::rem_pio2f};

// Small multiples of pi/2 rounded to double precision.
const C1_PIO2: f64 = 1. * f64::FRAC_PI_2; // 0x3FF921FB, 0x54442D18
const C2_PIO2: f64 = 2. * f64::FRAC_PI_2; // 0x400921FB, 0x54442D18
const C3_PIO2: f64 = 3. * f64::FRAC_PI_2; // 0x4012D97C, 0x7F3321D2
const C4_PIO2: f64 = 4. * f64::FRAC_PI_2; // 0x401921FB, 0x54442D18

/// The cosine of `x` (f32).
///
/// `x` is specified in radians.
pub fn cosf(x: f32) -> f32 {
  local x64 = x.promote();

  local mut ix = x.to_bits();
  local sign = (ix >> 31) != 0;
  ix &= 0x7fffffff;

  if ix <= 0x3f490fda {
    // |x| ~<= pi/4
    if ix < 0x39800000 {
      // |x| < 2**-12
      return 1.;
    }
    return k_cosf(x64);
  }
  if ix <= 0x407b53d1 {
    // |x| ~<= 5*pi/4
    if ix > 0x4016cbe3 {
      // |x|  ~> 3*pi/4
      return -k_cosf(if sign { x64 + C2_PIO2 } else { x64 - C2_PIO2 });
    } else {
      return if sign { k_sinf(x64 + C1_PIO2) } else { k_sinf(C1_PIO2 - x64) };
    }
  }

  if ix <= 0x40e231d5 {
    // |x| ~<= 9*pi/4 */
    if ix > 0x40afeddf {
      // |x| ~> 7*pi/4 */
      return k_cosf(if sign { x64 + C4_PIO2 } else { x64 - C4_PIO2 });
    } else {
      return if sign { k_sinf(-x64 - C3_PIO2) } else { k_sinf(x64 - C3_PIO2) };
    }
  }

  // cos(Inf or NaN) is NaN
  if ix >= 0x7f800000 { return x - x };

  // general argument reduction needed
  local (n, y) = rem_pio2f(x);
  match n & 3 {
    0 -> { k_cosf(y) },
    1 -> { k_sinf(-y) },
    2 -> { -k_cosf(y) },
    _ -> { k_sinf(y) }
  }
}
