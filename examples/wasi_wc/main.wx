// wc: prints the lines, words and bytes of standard input.
//
// A line is a byte 10. A word is a maximal run of bytes that are not ASCII
// whitespace (9 to 13 and 32). There is no Unicode handling.
package "wasi" as wasi;
package "fmt" as fmt;
use wasi::{Fd, heap};

func is_space(byte: u8) -> Bool {
    byte == ' ' || (byte >= '\t' && byte <= '\r')
}

func print(
    arena: heap::*wasi::Arena,
    digits: heap::*[u8],
    value: u32,
    separator: heap::&[u8],
) {
    Fd::STDOUT.write(arena, fmt::decimal::<heap>(digits, value));
    Fd::STDOUT.write(arena, separator);
}

func main() {
    local arena = wasi::arena();
    local buffer = arena.allocate_slice_uninit::<u8>(4096);
    local digits = arena.allocate_slice_uninit::<u8>(fmt::DECIMAL_LEN);
    // `in_word`: whether the previous byte, in this chunk or an earlier one,
    // was in a word.
    local (lines, words, bytes) = loop (
        lines: u32 = 0,
        words: u32 = 0,
        bytes: u32 = 0,
        in_word = False,
    ) {
        local chunk = Fd::STDIN.read(arena, buffer);
        if (chunk.len() == 0) { break (lines, words, bytes) };
        local (lines, words, in_word) = loop (
            i: u32 = 0,
            lines = lines,
            words = words,
            in_word = in_word,
        ) {
            if (i == chunk.len()) { break (lines, words, in_word) };
            local byte = chunk[i];
            local lines = if (byte == '\n') { lines + 1 } else { lines };
            if (is_space(byte)) { continue (i + 1, lines, words, False) };
            (i + 1, lines, if (in_word) { words } else { words + 1 }, True)
        };
        (lines, words, bytes + chunk.len(), in_word)
    };
    print(arena, digits, lines, " ");
    print(arena, digits, words, " ");
    print(arena, digits, bytes, "\n");
}

export {
    main as "_start",
    heap as "memory",
}
