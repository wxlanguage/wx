func add(a: i32, b: i32) -> i32 {
    a + b
}

func sub(a: i32, b: i32) -> i32 {
    a - b
}

func apply<F: Call where { Args = (i32, i32), Result = i32 }>(
    binop: F,
    a: i32,
    b: i32,
) -> i32 {
    binop(a, b)
}

func main() -> i32 {
    local a = apply(add, 5, 10);
    local b = apply(sub, 10, 5);

    a + b
}

export {
    main,
}
