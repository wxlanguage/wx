}

#[tag = "Not"]
pub trait Not {
    fn not(self) -> Self;
}

#[tag = "PartialEq"]
pub trait PartialEq {
    fn eq(self, other: Self) -> bool;

    #[inline]
    fn ne(self, other: Self) -> bool {
        !self.eq(other)
    }
}

pub trait Eq: PartialEq {}

#[tag = "PartialOrd"]
pub trait PartialOrd: PartialEq {
    fn lt(self, other: Self) -> bool;

    fn le(self, other: Self) -> bool;

    fn gt(self, other: Self) -> bool;

    fn ge(self, other: Self) -> bool;
}

pub enum Ordering: i8 {
    Less = -1,
    Equal = 0,
    Greater = 1,
}

impl Ordering {
    #[inline]
    pub fn of<T: PartialOrd>(a: T, b: T) -> Ordering {
        ((a > b) as i8 - (a < b) as i8) as Ordering
    }

    #[inline]
    pub fn is_lt(self) -> bool {
        self == Ordering::Less
    }

    #[inline]
    pub fn is_eq(self) -> bool {
        self == Ordering::Equal
    }

    #[inline]
    pub fn is_gt(self) -> bool {
        self == Ordering::Greater
    }

    #[inline]
    pub fn is_le(self) -> bool {
        self != Ordering::Greater
    }

    #[inline]
    pub fn is_ge(self) -> bool {
        self != Ordering::Less
    }

    #[inline]
    pub fn is_ne(self) -> bool {
        self != Ordering::Equal
    }

    #[inline]
    pub fn reverse(self) -> Ordering {
        match self {
            Ordering::Less -> { Ordering::Greater },
            Ordering::Equal -> { Ordering::Equal },
            Ordering::Greater -> { Ordering::Less }
        }
    }

    #[inline]
    pub fn then(self, other: Ordering) -> Ordering {
        match self {
            Ordering::Equal -> { other },
            _ -> { self }
        }
    }
}

pub trait Ord: PartialOrd + Eq {
    fn cmp(self, other: Self) -> Ordering;

    #[inline]
    fn min(self, other: Self) -> Self {
        if self < other { self } else { other }
    }

    #[inline]
    fn max(self, other: Self) -> Self {
        if self < other { other } else { self }
    }

    // NOT #[inline] yet, unlike `min`/`max` above: this body has statement-
    // position early `return`s. The inliner rewrites a callee `return` into a
    // `break` out of a wrapper block, but `opt` can only lower a `break` whose
    // target is a loop — a `break` to a plain block panics in `loop_data`
    // (opt/mod.rs). Re-add `#[inline]` once opt learns break-from-block.
    fn clamp(self, min: Self, max: Self) -> Self {
        if max < min { unreachable };
        if self < min { return min };
        if self > max { return max };
        self
    }
}

