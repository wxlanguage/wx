impl Rem for f64 {
    // Matches Rust/C `fmod`: truncating division, result has the sign of
    // the dividend.
    #[inline]
    fn rem(self: Self, rhs: Self) -> Self {
        self - rhs * (self / rhs).trunc()
    }
}

