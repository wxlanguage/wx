        f32_nearest(self)
    }

    #[inline]
    pub fn min(self, other: Self) -> Self {
        f32_min(self, other)
    }

    #[inline]
    pub fn max(self, other: Self) -> Self {
        f32_max(self, other)
    }

    #[inline]
    pub fn copysign(self, sign: Self) -> Self {
        f32_copysign(self, sign)
    }

    #[inline]
    pub fn to_bits(self) -> u32 {
        i32_reinterpret_f32(self) as u32
    }

    #[inline]
    pub fn from_bits(bits: u32) -> Self {
        f32_reinterpret_i32(bits as i32)
    }

    #[inline]
    pub fn promote(self) -> f64 {
        f64_promote_f32(self)
    }

    #[inline]
    pub fn to_i32(self) -> i32 {
        i32_trunc_f32(self)
    }

    #[inline]
    pub fn to_u32(self) -> u32 {
        u32_trunc_f32(self)
    }

    #[inline]
    pub fn to_i64(self) -> i64 {
        i64_trunc_f32(self)
    }

    #[inline]
    pub fn to_u64(self) -> u64 {
        u64_trunc_f32(self)
    }
}

