#[tag = "add"]
pub trait Add {
    fn add(self: Self, rhs: Self) -> Self;
}

#[tag = "sub"]
pub trait Sub {
    fn sub(self: Self, rhs: Self) -> Self;
}

#[tag = "mul"]
pub trait Mul {
    fn mul(self: Self, rhs: Self) -> Self;
}

#[tag = "div"]
pub trait Div {
    fn div(self: Self, rhs: Self) -> Self;
}

#[tag = "rem"]
pub trait Rem {
    fn rem(self: Self, rhs: Self) -> Self;
}

#[tag = "neg"]
pub trait Neg {
    fn neg(self: Self) -> Self;
}

#[tag = "bitand"]
pub trait BitAnd {
    fn bitand(self: Self, rhs: Self) -> Self;
}

#[tag = "bitor"]
pub trait BitOr {
    fn bitor(self: Self, rhs: Self) -> Self;
}

#[tag = "bitxor"]
pub trait BitXor {
    fn bitxor(self: Self, rhs: Self) -> Self;
}

#[tag = "shl"]
pub trait Shl {
    fn shl(self: Self, rhs: Self) -> Self;
}

#[tag = "shr"]
pub trait Shr {
    fn shr(self: Self, rhs: Self) -> Self;
}

#[tag = "bitnot"]
pub trait BitNot {
    fn bitnot(self: Self) -> Self;
}

pub const PAGE_SIZE: u32 = 65536;

/// Grows `mem` by `delta` pages; returns the previous size in pages, or `-1` on failure.
/// https://developer.mozilla.org/en-US/docs/WebAssembly/Reference/Memory/grow
#[intrinsic]
pub fn memory_grow<Mem: Memory>(mem: Mem, delta: Mem::Size) -> Mem::Size::Signed;

#[intrinsic]
pub fn memory_size<Mem: Memory>(mem: Mem) -> Mem::Size;

#[intrinsic]
pub fn slice_len<Mem: Memory, T>(slice: Mem::&[T]) -> Mem::Size;

#[intrinsic]
pub fn slice_ptr<Mem: Memory, T>(slice: Mem::&[T]) -> Mem::&T;

#[intrinsic]
pub fn slice_from_parts<Mem: Memory, T>(data: Mem::&T, len: Mem::Size) -> Mem::&[T];

#[intrinsic]
pub fn size_of<T, Mem: Memory>() -> Mem::Size;

#[intrinsic]
pub fn align_of<T, Mem: Memory>() -> Mem::Size;

#[intrinsic]
pub fn memory_fill<Mem: Memory>(dst: Mem::*u8, val: u8, len: Mem::Size);

#[intrinsic]
pub fn memory_copy<
    Size: PointerSize,
    SrcMem: Memory where { Size = Size },
    DstMem: Memory where { Size = Size },
>(dst: DstMem::*u8, src: SrcMem::&u8, len: Size);

