#[intrinsic]
pub type i8;

#[intrinsic]
pub type u8;

#[intrinsic]
pub type i16;

#[intrinsic]
pub type u16;

#[intrinsic]
pub type i32;

#[intrinsic]
pub type u32;

#[intrinsic]
pub type i64;

#[intrinsic]
pub type u64;

#[intrinsic]
pub type f32;

#[intrinsic]
pub type f64;

#[intrinsic]
pub type bool;

#[intrinsic]
pub type char;

#[intrinsic]
pub type never;

pub const PAGE_SIZE: u32 = 65536;

#[intrinsic]
pub fn memory_grow<Mem: Memory>(mem: Mem, delta: Mem::Size) -> Mem::Size::Signed;

#[intrinsic]
pub fn memory_size<Mem: Memory>(mem: Mem) -> Mem::Size;

#[intrinsic]
pub fn slice_len<Mem: Memory, T>(slice: Mem::&[T]) -> Mem::Size;

#[intrinsic]
pub fn slice_ptr<Mem: Memory, T>(slice: Mem::&[T]) -> Mem::&T;

#[intrinsic]
pub fn slice_from_parts<Mem: Memory, T>(data: Mem::&T, len: Mem::Size) -> Mem::&[T];

#[intrinsic]
pub fn size_of<T, Mem: Memory>() -> Mem::Size;

#[intrinsic]
pub fn align_of<T, Mem: Memory>() -> Mem::Size;

#[intrinsic]
pub fn memory_fill<Mem: Memory>(dst: Mem::*u8, val: u8, len: Mem::Size);

#[intrinsic]
pub fn memory_copy<
    Size: PointerSize,
    SrcMem: Memory where { Size = Size },
    DstMem: Memory where { Size = Size },
>(dst: DstMem::*u8, src: SrcMem::&u8, len: Size);

#[intrinsic]
pub fn i64_extend_i32(value: i32) -> i64;

#[intrinsic]
pub fn u64_extend_u32(value: u32) -> u64;

#[intrinsic]
pub fn i32_wrap_i64(value: i64) -> i32;

#[intrinsic]
pub fn f32_sqrt(value: f32) -> f32;

#[intrinsic]
pub fn f64_sqrt(value: f64) -> f64;

#[intrinsic]
pub fn f32_abs(value: f32) -> f32;

#[intrinsic]
pub fn f64_abs(value: f64) -> f64;

#[intrinsic]
pub fn f32_floor(value: f32) -> f32;

#[intrinsic]
pub fn f64_floor(value: f64) -> f64;

#[intrinsic]
pub fn f32_ceil(value: f32) -> f32;

#[intrinsic]
pub fn f64_ceil(value: f64) -> f64;

#[intrinsic]
pub fn f32_convert_i32(value: i32) -> f32;

#[intrinsic]
pub fn f32_convert_u32(value: u32) -> f32;

#[intrinsic]
pub fn f32_convert_i64(value: i64) -> f32;

#[intrinsic]
pub fn f32_convert_u64(value: u64) -> f32;

#[intrinsic]
pub fn f64_convert_i32(value: i32) -> f64;

#[intrinsic]
pub fn f64_convert_u32(value: u32) -> f64;

#[intrinsic]
pub fn f64_convert_i64(value: i64) -> f64;

#[intrinsic]
pub fn f64_convert_u64(value: u64) -> f64;

#[intrinsic]
pub fn i32_trunc_f32(value: f32) -> i32;

#[intrinsic]
pub fn u32_trunc_f32(value: f32) -> u32;

#[intrinsic]
pub fn i32_trunc_f64(value: f64) -> i32;

#[intrinsic]
pub fn u32_trunc_f64(value: f64) -> u32;

#[intrinsic]
pub fn i64_trunc_f32(value: f32) -> i64;

#[intrinsic]
pub fn u64_trunc_f32(value: f32) -> u64;

#[intrinsic]
pub fn i64_trunc_f64(value: f64) -> i64;

#[intrinsic]
pub fn u64_trunc_f64(value: f64) -> u64;

#[intrinsic]
pub fn f64_promote_f32(value: f32) -> f64;

#[intrinsic]
pub fn f32_demote_f64(value: f64) -> f32;

impl f32 {
    pub const PI: f32 = 3.14159265358979323846264338327950288;
}

impl f64 {
    pub const PI: f64 = 3.14159265358979323846264338327950288;
}

pub typeset Integer { u8, i8, u16, i16, u32, i32, u64, i64 }

trait UnsignedInt {
    type Signed: SignedInt where { Unsigned = Self };
}

trait SignedInt {
    type Unsigned: UnsignedInt where { Signed = Self };
}

impl UnsignedInt for u8 {
    type Signed = i8;
}

impl UnsignedInt for u16 {
    type Signed = i16;
}

impl UnsignedInt for u32 {
    type Signed = i32;
}

impl UnsignedInt for u64 {
    type Signed = i64;
}

impl SignedInt for i8 {
    type Unsigned = u8;
}

impl SignedInt for i16 {
    type Unsigned = u16;
}

impl SignedInt for i32 {
    type Unsigned = u32;
}

impl SignedInt for i64 {
    type Unsigned = u64;
}

#[tag = "pointer_size"]
pub typeset PointerSize { u32, u64 }

pub trait Memory {
    type Size: PointerSize + UnsignedInt;

    const MEMORY_INDEX: u32;

    const DATA_END: Self::*u8;

    #[inline]
    fn grow(self, delta: Self::Size) -> Self::Size::Signed {
        memory_grow(self, delta)
    }

    #[inline]
    fn size(self) -> Self::Size {
        memory_size(self)
    }
}

pub struct Layout<Mem: Memory> {
    pub size: Mem::Size,
    pub align: Mem::Size,
}

impl<Mem: Memory> Layout<Mem> {
    #[inline]
    pub fn of<T>() -> Self {
        Self::{ size: size_of::<T>(), align: align_of::<T>() }
    }

    #[inline]
    pub fn array<T>(count: Mem::Size) -> Self {
        Self::{ align: align_of::<T>(), size: size_of::<T>() * count }
    }
}

pub trait Allocator {
    type Mem: Memory;

    fn reserve(self: Self::Mem::*Self, layout: Layout<Self::Mem>) -> Self::Mem::*u8;

    #[inline]
    fn alloc<T>(self: Self::Mem::*Self, value: T) -> Self::Mem::*T {
        local ptr = self.reserve(Layout::of::<T>()) as Self::Mem::*T;
        ptr.* = value;
        ptr
    }

    #[inline]
    fn alloc_slice<T>(self: Self::Mem::*Self, len: Self::Mem::Size) -> Self::Mem::*[T] {
        slice_from_parts(
            self.reserve(Layout::array::<T>(len)) as Self::Mem::&T,
            len,
        ) as _
    }
}

pub module ptr {
    #[inline]
    pub fn null<Mem: Memory, T>() -> Mem::&T {
        0 as _
    }

    #[inline]
    pub fn null_mut<Mem: Memory, T>() -> Mem::*T {
        0 as _
    }

    #[inline]
    pub fn is_null<Mem: Memory, T>(ptr: Mem::&T) -> bool {
        ptr as Mem::Size == 0
    }

    #[inline]
    pub fn cast_mut<Mem: Memory, T>(ptr: Mem::&T) -> Mem::*T {
        ptr as _
    }

    #[inline]
    pub fn add<Mem: Memory, T>(ptr: Mem::&T, count: Mem::Size) -> Mem::&T {
        (ptr as Mem::Size + count * size_of::<T, Mem>()) as _
    }

    #[inline]
    pub fn sub<Mem: Memory, T>(ptr: Mem::&T, count: Mem::Size) -> Mem::&T {
        (ptr as Mem::Size - count * size_of::<T, Mem>()) as _
    }

    #[inline]
    pub fn add_mut<Mem: Memory, T>(ptr: Mem::*T, count: Mem::Size) -> Mem::*T {
        (ptr as Mem::Size + count * size_of::<T, Mem>()) as _
    }

    #[inline]
    pub fn sub_mut<Mem: Memory, T>(ptr: Mem::*T, count: Mem::Size) -> Mem::*T {
        (ptr as Mem::Size - count * size_of::<T, Mem>()) as _
    }

    #[inline]
    pub fn align_up<Mem: Memory>(addr: Mem::Size, align: Mem::Size) -> Mem::Size {
        local mask = align - 1;
        local result = (addr + mask) & ^mask;
        if result < addr { unreachable }
        result
    }
}

impl<Mem: Memory, T> Mem::&[T] {
    #[inline]
    pub fn len(self) -> Mem::Size {
        slice_len(self)
    }

    #[inline]
    pub fn ptr(self) -> Mem::&T {
        slice_ptr(self)
    }
}

const ASCII_CASE_MASK: u8 = 0b0010_0000;

impl char {
    #[inline]
    pub fn to_ascii_uppercase(self) -> char {
        if self.is_ascii_lowercase() {
            ((self as u8) ^ ASCII_CASE_MASK) as char
        } else {
            self
        }
    }

    #[inline]
    pub fn to_ascii_lowercase(self) -> char {
        if self.is_ascii_uppercase() {
            ((self as u8) ^ ASCII_CASE_MASK) as char
        } else {
            self
        }
    }

    #[inline]
    pub fn is_ascii(self) -> bool {
        (self as u32) <= 0x7F
    }

    #[inline]
    pub fn is_ascii_uppercase(self) -> bool {
        self >= 'A' && self <= 'Z'
    }

    #[inline]
    pub fn is_ascii_lowercase(self) -> bool {
        self >= 'a' && self <= 'z'
    }

    #[inline]
    pub fn is_ascii_alphabetic(self) -> bool {
        (self >= 'A' && self <= 'Z') | (self >= 'a' && self <= 'z')
    }

    #[inline]
    pub fn is_ascii_digit(self) -> bool {
        self >= '0' && self <= '9'
    }

    #[inline]
    pub fn is_ascii_alphanumeric(self) -> bool {
        (self >= 'A' && self <= 'Z')
            | (self >= 'a' && self <= 'z')
            | (self >= '0' && self <= '9')
    }

    #[inline]
    pub fn is_ascii_whitespace(self) -> bool {
        self == '\t'
            || self == '\n'
            || self == '\x0C'
            || self == '\r'
            || self == ' '
    }

    #[inline]
    pub fn is_ascii_control(self) -> bool {
        (self as u32) <= 0x1F || self == '\x7F'
    }

    #[inline]
    pub fn is_ascii_hexdigit(self) -> bool {
        (self >= '0' && self <= '9')
            | (self >= 'A' && self <= 'F')
            | (self >= 'a' && self <= 'f')
    }

    #[inline]
    pub fn is_ascii_punctuation(self) -> bool {
        (self >= '!' && self <= '/')
            | (self >= ':' && self <= '@')
            | (self >= '[' && self <= '`')
            | (self >= '{' && self <= '~')
    }

    #[inline]
    pub fn is_ascii_graphic(self) -> bool {
        self >= '!' && self <= '~'
    }
}
