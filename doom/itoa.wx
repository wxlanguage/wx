use std::*;

#[memory_limits(min_pages = 1)]
memory heap: Memory where { Size = u32 };

import "console" as console {
  func log(message: heap::&[u8]);
}

// ── bump allocator ────────────────────────────────────────────────────────────

global mut bump: heap::*u8 = heap::DATA_END;

func alloc_bytes(size: u32, align: u32) -> heap::*u8 {
    local ptr = ptr::align_up::<heap>(transmute(bump), align);
    local new_end = ptr + size;
    local cur_end = heap.size_bytes();
    if new_end > cur_end {
        local needed = (new_end - cur_end + heap::PAGE_SIZE - 1) / heap::PAGE_SIZE;
        _ = heap.grow(needed);
    }
    bump = transmute(new_end);
    transmute(ptr)
}

func alloc_array<T>(count: u32) -> heap::*T {
    transmute(alloc_bytes(size_of::<T, heap>() * count, align_of::<T, heap>()))
}

#[inline]
pub func reset() {
    bump = heap::DATA_END;
}

// ── integer -> string conversion ──────────────────────────────────────────────

func itoa(value: i32) -> heap::&[u8] {
    local buf: heap::*u8 = alloc_array::<u8>(12);
    local mut ptr: heap::*u8 = buf;
    local mut len: u32 = 0;

    local mut x: i64 = i64_extend_i32(value);
    local mut neg: Bool = False;
    if x < 0 {
        neg = True;
        x = -x;
    }

    loop {
        if x == 0 { break; }
        local digit: i32 = i32_wrap_i64(x % 10);
        ptr.* = transmute::<_, u8>(digit) + '0';
        ptr = ptr::add_mut(ptr, 1);
        len += 1;
        x = x / 10;
    };

    if len == 0 {
        ptr.* = '0';
        ptr = ptr::add_mut(ptr, 1);
        len = 1;
    }

    if neg {
        ptr.* = '-';
        ptr = ptr::add_mut(ptr, 1);
        len += 1;
    }

    // Reverse the collected characters.
    local mut i: u32 = 0;
    loop {
        if i * 2 >= len { break; }
        local a = ptr::add(buf, i).*;
        local b = ptr::add(buf, len - 1 - i).*;
        ptr::add_mut(buf, i).* = b;
        ptr::add_mut(buf, len - 1 - i).* = a;
        i += 1;
    };

    slice_from_parts(buf, len)
}

pub func demo() -> i32 {
    console::log(itoa(0));
    console::log(itoa(12345));
    console::log(itoa(-98765));

    reset();
    0
}

export {
    heap as "memory",
    reset,
    demo,
}
